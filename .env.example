# En Neon: Dashboard → Connect → "Connection string" → copiar completa
# Debe empezar con postgresql:// (no es la URL del panel ni una API key)
DATABASE_URL=postgresql://usuario:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Neon Auth: Dashboard → Auth → Configuration → Auth Base URL
VITE_NEON_AUTH_URL=https://ep-xxx.neonauth.us-east-2.aws.neon.build/neondb/auth
